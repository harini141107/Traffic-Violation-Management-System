<%- include('partials/header', { pageTitle: 'Vehicles', active: 'vehicles' }) %>
  <div class="page-head">
    <h1>Vehicles</h1>
    <p class="page-sub">Manage registered vehicles</p>
  </div>

  <div class="panel">
    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>
    <a class="link" style="margin-top:0; margin-bottom:1rem; text-align:left;" href="/vehicles/add">+ Add Vehicle</a>

    <table>
      <thead>
        <tr>
          <th>Registration No</th>
          <th>Owner</th>
          <th>Type</th>
          <th>Model</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (vehicles.length === 0) { %>
          <tr><td colspan="5">No vehicles found. Add one to get started.</td></tr>
        <% } %>
        <% vehicles.forEach(v => { %>
          <tr>
            <td><%= v.registration_no %></td>
            <td><%= v.owner_name %></td>
            <td><%= v.vehicle_type %></td>
            <td><%= v.model || '-' %></td>
            <td>
              <a href="/vehicles/edit/<%= v.vehicle_id %>">Edit</a>
              <form action="/vehicles/delete/<%= v.vehicle_id %>" method="POST" style="display:inline"
                    onsubmit="return confirm('Delete this vehicle?');">
                <button type="submit" class="link-btn" style="width:auto; padding:0;">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<%- include('partials/footer') %>
<%- include('partials/header', { pageTitle: 'Challans', active: 'challans' }) %>
  <div class="page-head">
    <h1>Challans</h1>
    <p class="page-sub">Generated challans and payment status</p>
  </div>
  <div class="panel">
    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>
    <a class="link" style="margin-top:0; margin-bottom:1rem; text-align:left;" href="/challans/add">+ Generate Challan</a>

    <table>
      <thead>
        <tr>
          <th>Vehicle</th>
          <th>Violator</th>
          <th>Type</th>
          <th>Fine</th>
          <th>Due Date</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (challans.length === 0) { %>
          <tr><td colspan="7">No challans generated yet.</td></tr>
        <% } %>
        <% challans.forEach(c => { %>
          <tr>
            <td><%= c.registration_no %></td>
            <td><%= c.violator_name %></td>
            <td><%= c.violation_type %></td>
            <td>₹<%= c.fine_amount %></td>
            <td><%= new Date(c.due_date).toLocaleDateString() %></td>
            <td><span class="badge <%= c.status === 'Paid' ? 'badge-paid' : 'badge-unpaid' %>"><%= c.status %></span></td>
            <td>
              <% if (c.status === 'Unpaid') { %>
                <a href="/payments/pay/<%= c.challan_id %>">Pay</a>
              <% } %>
              <form action="/challans/delete/<%= c.challan_id %>" method="POST" style="display:inline"
                    onsubmit="return confirm('Delete this challan?');">
                <button type="submit" class="link-btn" style="width:auto; padding:0;">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<%- include('partials/footer') %>
<%- include('partials/header', { pageTitle: 'Reports', active: 'reports' }) %>
  <div class="page-head">
    <h1>Reports</h1>
  </div>
  <% if (error) { %>
    <p class="error"><%= error %></p>
  <% } %>

  <div class="quick-links" style="margin-bottom:1.5rem;">
    <div class="panel" style="text-align:center; margin-bottom:0;">
      <div style="font-size:1.8rem; font-weight:bold; color:var(--navy-950);"><%= totalVehicles %></div>
      <div>Vehicles</div>
    </div>
    <div class="panel" style="text-align:center; margin-bottom:0;">
      <div style="font-size:1.8rem; font-weight:bold; color:var(--navy-950);"><%= totalViolators %></div>
      <div>Violators</div>
    </div>
    <div class="panel" style="text-align:center; margin-bottom:0;">
      <div style="font-size:1.8rem; font-weight:bold; color:var(--navy-950);"><%= totalViolations %></div>
      <div>Violations</div>
    </div>
  </div>

  <div class="panel">
    <h3 style="margin-top:0;">Violations by Type</h3>
    <table>
      <thead>
        <tr><th>Violation Type</th><th>Count</th></tr>
      </thead>
      <tbody>
        <% if (byType.length === 0) { %>
          <tr><td colspan="2">No data yet.</td></tr>
        <% } %>
        <% byType.forEach(t => { %>
          <tr><td><%= t.violation_type %></td><td><%= t.count %></td></tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="panel">
    <h3 style="margin-top:0;">Recent Violations</h3>
    <table>
      <thead>
        <tr><th>Vehicle</th><th>Violator</th><th>Type</th><th>Location</th><th>Date</th></tr>
      </thead>
      <tbody>
        <% if (recent.length === 0) { %>
          <tr><td colspan="5">No data yet.</td></tr>
        <% } %>
        <% recent.forEach(r => { %>
          <tr>
            <td><%= r.registration_no %></td>
            <td><%= r.violator_name %></td>
            <td><%= r.violation_type %></td>
            <td><%= r.location %></td>
            <td><%= new Date(r.violation_date).toLocaleString() %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<%- include('partials/footer') %>
<!DOCTYPE html>
<html>
<head>
  <title>Violations - TVMS</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="card list-card">
    <h2>Violations</h2>
    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>
    <a class="link" href="/violations/add">+ Record Violation</a>

    <table>
      <thead>
        <tr>
          <th>Vehicle</th>
          <th>Violator</th>
          <th>Type</th>
          <th>Location</th>
          <th>Date</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (violations.length === 0) { %>
          <tr><td colspan="6">No violations recorded yet.</td></tr>
        <% } %>
        <% violations.forEach(v => { %>
          <tr>
            <td><%= v.registration_no %></td>
            <td><%= v.violator_name %></td>
            <td><%= v.violation_type %></td>
            <td><%= v.location %></td>
            <td><%= new Date(v.violation_date).toLocaleString() %></td>
            <td>
              <a href="/violations/edit/<%= v.violation_id %>">Edit</a>
              <form action="/violations/delete/<%= v.violation_id %>" method="POST" style="display:inline"
                    onsubmit="return confirm('Delete this violation record?');">
                <button type="submit" class="link-btn">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <a class="link" href="/dashboard">&larr; Back to Dashboard</a>
  </div>
</body>
</html>
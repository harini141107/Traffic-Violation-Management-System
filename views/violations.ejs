<%- include('partials/header', { pageTitle: 'Violations', active: 'violations' }) %>
  <div class="page-head">
    <h1>Violations</h1>
    <p class="page-sub">Recorded traffic violations</p>
  </div>
  <div class="panel">
    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>
    <a class="link" style="margin-top:0; margin-bottom:1rem; text-align:left;" href="/violations/add">+ Record Violation</a>

    <table>
      <thead>
        <tr>
          <th>Vehicle</th>
          <th>Violator</th>
          <th>Type</th>
          <th>Location</th>
          <th>Date</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (violations.length === 0) { %>
          <tr><td colspan="6">No violations recorded yet.</td></tr>
        <% } %>
        <% violations.forEach(v => { %>
          <tr>
            <td><%= v.registration_no %></td>
            <td><%= v.violator_name %></td>
            <td><%= v.violation_type %></td>
            <td><%= v.location %></td>
            <td><%= new Date(v.violation_date).toLocaleString() %></td>
            <td>
              <a href="/violations/edit/<%= v.violation_id %>">Edit</a>
              <form action="/violations/delete/<%= v.violation_id %>" method="POST" style="display:inline"
                    onsubmit="return confirm('Delete this violation record?');">
                <button type="submit" class="link-btn" style="width:auto; padding:0;">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<%- include('partials/footer') %>
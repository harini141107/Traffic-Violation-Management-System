<%- include('partials/header', { pageTitle: mode === 'add' ? 'Record Violation' : 'Edit Violation', active: 'violations' }) %>
  <div class="page-head">
    <h1><%= mode === 'add' ? 'Record Violation' : 'Edit Violation' %></h1>
  </div>
  <div class="panel" style="max-width:480px;">
    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>
    <form action="<%= mode === 'add' ? '/violations/add' : '/violations/edit/' + violation.violation_id %>" method="POST">
      <label>Vehicle</label>
      <select name="vehicle_id" required>
        <option value="">-- Select Vehicle --</option>
        <% vehicles.forEach(v => { %>
          <option value="<%= v.vehicle_id %>" <%= violation && violation.vehicle_id === v.vehicle_id ? 'selected' : '' %>>
            <%= v.registration_no %>
          </option>
        <% }) %>
      </select>

      <label>Violator</label>
      <select name="violator_id" required>
        <option value="">-- Select Violator --</option>
        <% violators.forEach(v => { %>
          <option value="<%= v.violator_id %>" <%= violation && violation.violator_id === v.violator_id ? 'selected' : '' %>>
            <%= v.name %> (<%= v.license_no %>)
          </option>
        <% }) %>
      </select>

      <label>Violation Type</label>
      <select name="violation_type" required>
        <option value="">-- Select Type --</option>
        <% types.forEach(t => { %>
          <option value="<%= t %>" <%= violation && violation.violation_type === t ? 'selected' : '' %>><%= t %></option>
        <% }) %>
      </select>

      <label>Location</label>
      <input type="text" name="location" value="<%= violation ? violation.location : '' %>" required>

      <label>Date &amp; Time</label>
      <input type="datetime-local" name="violation_date"
             value="<%= violation ? new Date(violation.violation_date).toISOString().slice(0,16) : '' %>" required>

      <button type="submit"><%= mode === 'add' ? 'Record Violation' : 'Save Changes' %></button>
    </form>
    <a class="link" href="/violations">&larr; Back to Violations</a>
  </div>
<%- include('partials/footer') %>
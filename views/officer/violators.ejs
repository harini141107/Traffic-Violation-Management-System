<%- include('../partials/header', { pageTitle: 'Verify Violator', active: 'violators' }) %>
<div class="page-head"><h1>Verify Violator</h1><p class="page-sub">Search by licence number or name and inspect previous records.</p></div>
<div class="panel"><form class="filter-row" action="/officer/violators" method="GET"><div><label>Name / Licence Number</label><input name="search" value="<%= filters.search %>" placeholder="Enter name or licence number" required></div><div><button type="submit">Search</button></div></form></div>
<div class="panel"><div class="table-scroll"><table><thead><tr><th>Name</th><th>Licence</th><th>Phone</th><th>Demerit</th><th>Licence Status</th><th>Action</th></tr></thead><tbody><% if (!violators.length) { %><tr><td colspan="6"><%= filters.search ? 'No violator found.' : 'Search for a violator to begin verification.' %></td></tr><% } %><% violators.forEach(v => { %><tr><td><%= v.name %></td><td><%= v.license_no %></td><td><%= v.phone || '—' %></td><td><%= v.demerit_points %></td><td><span class="badge <%= v.license_status === 'Active' ? 'badge-paid' : 'badge-unpaid' %>"><%= v.license_status %></span></td><td><a href="/officer/violators/<%= v.violator_id %>">View verification</a></td></tr><% }) %></tbody></table></div></div>
<%- include('../partials/footer') %>

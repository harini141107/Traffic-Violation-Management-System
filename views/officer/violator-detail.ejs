<%- include('../partials/header', { pageTitle: 'Violator Verification', active: 'violators' }) %>
<div class="page-head"><h1>Violator Verification</h1><p class="page-sub"><%= violator.name %> — <%= violator.license_no %></p></div>
<div class="detail-grid officer-detail"><div class="detail-item"><div class="label">Name</div><div class="value"><%= violator.name %></div></div><div class="detail-item"><div class="label">Licence Number</div><div class="value"><%= violator.license_no %></div></div><div class="detail-item"><div class="label">Phone</div><div class="value"><%= violator.phone || '—' %></div></div><div class="detail-item"><div class="label">Address</div><div class="value"><%= violator.address || '—' %></div></div><div class="detail-item"><div class="label">Demerit Points</div><div class="value"><%= violator.demerit_points %></div></div><div class="detail-item"><div class="label">Licence Status</div><div class="value"><%= violator.license_status %></div></div></div>
<div class="panel"><h3>Previous Violations & Challans</h3><div class="table-scroll"><table><thead><tr><th>Violation</th><th>Vehicle</th><th>Date</th><th>Challan</th><th>Fine</th><th>Status</th></tr></thead><tbody><% if (!history.length) { %><tr><td colspan="6">No previous enforcement records found.</td></tr><% } %><% history.forEach(h => { %><tr><td>#<%= h.violation_id %> — <%= h.violation_type %><br><small><%= h.location %></small></td><td><%= h.registration_no %></td><td><%= new Date(h.violation_date).toLocaleString() %></td><td><%= h.challan_id ? '#' + h.challan_id : '—' %></td><td><%= h.fine_amount ? '₹' + Number(h.fine_amount).toFixed(2) : '—' %></td><td><%= h.challan_status || 'No challan' %></td></tr><% }) %></tbody></table></div></div>
<%- include('../partials/footer') %>

<%- include('../partials/header', { pageTitle: 'Generate Challan', active: 'challans' }) %>
<div class="page-head"><h1>Generate Challan</h1><p class="page-sub">Create a challan for a violation that does not already have one.</p></div>
<div class="panel officer-form-panel"><% if (error) { %><p class="error"><%= error %></p><% } %><form action="/officer/challans/add" method="POST"><label>Recorded Violation</label><select name="violation_id" required><option value="">-- Select Violation --</option><% violations.forEach(v => { %><option value="<%= v.violation_id %>">#<%= v.violation_id %> — <%= v.registration_no %> — <%= v.violator_name %> — <%= v.violation_type %></option><% }) %></select><label>Due Date</label><input type="date" name="due_date" required><p class="form-note">The fine is calculated from the existing violation-type fine rules. Duplicate challans are blocked by the existing database relationship.</p><button type="submit">Generate Challan</button></form></div>
<%- include('../partials/footer') %>

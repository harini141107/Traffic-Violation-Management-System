<%- include('../partials/header', { pageTitle: 'Officer Challans', active: 'challans' }) %>
<div class="page-head"><h1>Challans</h1><p class="page-sub">Monitor generated challans, fine amounts and payment status.</p></div>
<div class="panel"><form class="filter-row" action="/officer/challans" method="GET"><div><label>Search</label><input name="search" value="<%= filters.search %>" placeholder="Challan, violation, vehicle, licence or violator"></div><div><label>Status</label><select name="status"><option value="">All statuses</option><option value="Unpaid" <%= filters.status === 'Unpaid' ? 'selected' : '' %>>Unpaid</option><option value="Paid" <%= filters.status === 'Paid' ? 'selected' : '' %>>Paid</option></select></div><div><button type="submit">Filter</button></div></form></div>
<div class="panel"><div class="section-heading"><h3>Challan Records (<%= challans.length %>)</h3><a class="button-link" href="/officer/challans/add">+ Generate Challan</a></div><div class="table-scroll"><table><thead><tr><th>Challan</th><th>Violation</th><th>Vehicle</th><th>Violator</th><th>Fine</th><th>Due</th><th>Status</th><th>Payment</th></tr></thead><tbody>
<% if (!challans.length) { %><tr><td colspan="8">No matching challans found.</td></tr><% } %><% challans.forEach(c => { %><tr><td><a href="/officer/challans/<%= c.challan_id %>">#<%= c.challan_id %></a></td><td>#<%= c.violation_id %> — <%= c.violation_type %></td><td><%= c.registration_no %></td><td><%= c.violator_name %><br><small><%= c.license_no %></small></td><td>₹<%= Number(c.fine_amount).toFixed(2) %></td><td><%= new Date(c.due_date).toLocaleDateString() %></td><td><span class="badge <%= c.status === 'Paid' ? 'badge-paid' : 'badge-unpaid' %>"><%= c.status %></span></td><td><%= c.amount_paid > 0 ? '₹' + Number(c.amount_paid).toFixed(2) : '—' %><% if (c.payment_date) { %><br><small><%= new Date(c.payment_date).toLocaleDateString() %></small><% } %></td></tr><% }) %>
</tbody></table></div></div>
<%- include('../partials/footer') %>

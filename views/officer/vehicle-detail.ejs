<%- include('../partials/header', { pageTitle: 'Vehicle Verification', active: 'vehicles' }) %>
<div class="page-head"><h1>Vehicle Verification</h1><p class="page-sub"><%= vehicle.registration_no %></p></div>
<div class="detail-grid officer-detail"><div class="detail-item"><div class="label">Registration Number</div><div class="value"><%= vehicle.registration_no %></div></div><div class="detail-item"><div class="label">Owner Name</div><div class="value"><%= vehicle.owner_name %></div></div><div class="detail-item"><div class="label">Vehicle Type</div><div class="value"><%= vehicle.vehicle_type %></div></div><div class="detail-item"><div class="label">Model</div><div class="value"><%= vehicle.model || '—' %></div></div></div>
<div class="panel"><h3>Previous Violations & Challans</h3><div class="table-scroll"><table><thead><tr><th>Violation</th><th>Violator</th><th>Date</th><th>Challan</th><th>Fine</th><th>Status</th></tr></thead><tbody><% if (!history.length) { %><tr><td colspan="6">No previous enforcement records found.</td></tr><% } %><% history.forEach(h => { %><tr><td>#<%= h.violation_id %> — <%= h.violation_type %><br><small><%= h.location %></small></td><td><%= h.violator_name %><br><small><%= h.license_no %></small></td><td><%= new Date(h.violation_date).toLocaleString() %></td><td><%= h.challan_id ? '#' + h.challan_id : '—' %></td><td><%= h.fine_amount ? '₹' + Number(h.fine_amount).toFixed(2) : '—' %></td><td><%= h.challan_status || 'No challan' %></td></tr><% }) %></tbody></table></div></div>
<%- include('../partials/footer') %>

<%- include('../partials/header', { pageTitle: 'Challan Details', active: 'challans' }) %>
<div class="page-head"><h1>Challan #<%= challan.challan_id %></h1><p class="page-sub">Payment and enforcement details.</p></div>
<div class="detail-grid officer-detail"><div class="detail-item"><div class="label">Fine Amount</div><div class="value">₹<%= Number(challan.fine_amount).toFixed(2) %></div></div><div class="detail-item"><div class="label">Status</div><div class="value"><span class="badge <%= challan.status === 'Paid' ? 'badge-paid' : 'badge-unpaid' %>"><%= challan.status %></span></div></div><div class="detail-item"><div class="label">Due Date</div><div class="value"><%= new Date(challan.due_date).toLocaleDateString() %></div></div><div class="detail-item"><div class="label">Payment</div><div class="value"><%= challan.amount_paid > 0 ? '₹' + Number(challan.amount_paid).toFixed(2) : 'No payment recorded' %><% if (challan.payment_mode) { %> — <%= challan.payment_mode %><% } %></div></div><div class="detail-item"><div class="label">Violation</div><div class="value">#<%= challan.violation_id %> — <%= challan.violation_type %></div></div><div class="detail-item"><div class="label">Vehicle</div><div class="value"><%= challan.registration_no %></div></div><div class="detail-item"><div class="label">Violator</div><div class="value"><%= challan.violator_name %> — <%= challan.license_no %></div></div><div class="detail-item"><div class="label">Location / Date</div><div class="value"><%= challan.location %><br><%= new Date(challan.violation_date).toLocaleString() %></div></div></div>
<div class="panel"><a class="button-link" href="/officer/challans">&larr; Back to Challans</a></div>
<%- include('../partials/footer') %>

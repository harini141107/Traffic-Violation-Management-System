<%- include('../partials/header', { pageTitle: 'Violation Details', active: 'violations' }) %>
<div class="page-head"><h1>Violation #<%= violation.violation_id %></h1><p class="page-sub">Complete enforcement record.</p></div>
<div class="detail-grid officer-detail"><div class="detail-item"><div class="label">Violation Type</div><div class="value"><%= violation.violation_type %></div></div><div class="detail-item"><div class="label">Date & Time</div><div class="value"><%= new Date(violation.violation_date).toLocaleString() %></div></div><div class="detail-item"><div class="label">Location</div><div class="value"><%= violation.location %></div></div><div class="detail-item"><div class="label">Vehicle</div><div class="value"><%= violation.registration_no %> — <%= violation.vehicle_type %></div></div><div class="detail-item"><div class="label">Violator</div><div class="value"><%= violation.violator_name %></div></div><div class="detail-item"><div class="label">Licence</div><div class="value"><%= violation.license_no %> — <%= violation.license_status %></div></div><div class="detail-item"><div class="label">Demerit Points</div><div class="value"><%= violation.demerit_points %></div></div><div class="detail-item"><div class="label">Challan</div><div class="value"><% if (violation.challan_id) { %><a href="/officer/challans/<%= violation.challan_id %>">#<%= violation.challan_id %></a> — ₹<%= Number(violation.fine_amount).toFixed(2) %> (<%= violation.challan_status %>)<% } else { %>Not generated — <a href="/officer/challans/add">Generate</a><% } %></div></div></div>
<div class="panel"><a class="button-link" href="/officer/violations">&larr; Back to Violations</a></div>
<%- include('../partials/footer') %>

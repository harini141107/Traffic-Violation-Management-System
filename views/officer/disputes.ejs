<%- include('../partials/header', { pageTitle: 'Officer Disputes', active: 'disputes' }) %>
<div class="page-head"><h1>Disputes</h1><p class="page-sub">Review dispute information and add operational remarks. Final resolution remains an Admin action.</p></div>
<div class="panel"><div class="table-scroll"><table><thead><tr><th>Dispute</th><th>Challan</th><th>Violator</th><th>Reason</th><th>Status</th><th>Officer Remark</th></tr></thead><tbody>
<% if (!disputes.length) { %><tr><td colspan="6">No disputes found.</td></tr><% } %><% disputes.forEach(d => { %><tr><td>#<%= d.dispute_id %><br><small><%= new Date(d.filed_date).toLocaleDateString() %></small></td><td>#<%= d.challan_id %><br>₹<%= Number(d.fine_amount).toFixed(2) %></td><td><%= d.violator_name %><br><small><%= d.license_no %> / <%= d.registration_no %></small></td><td><%= d.reason %></td><td><span class="badge <%= d.status === 'Pending' ? 'badge-pending' : 'badge-neutral' %>"><%= d.status %></span></td><td><% if (d.status === 'Pending') { %><form class="inline-form" action="/officer/disputes/<%= d.dispute_id %>/remark" method="POST"><input name="resolution_note" value="<%= d.resolution_note || '' %>" placeholder="Add remark" required><button type="submit">Save Remark</button></form><% } else { %><%= d.resolution_note || 'No remark' %><% } %></td></tr><% }) %>
</tbody></table></div></div>
<%- include('../partials/footer') %>

<%- include('../partials/header', { pageTitle: 'Officer Search', active: 'search' }) %>
<div class="page-head"><h1>Operational Search</h1><p class="page-sub">Search vehicles, licences, violators, violations and challans from one place.</p></div>
<div class="panel"><form class="filter-row" action="/officer/search" method="GET"><div><label>Search</label><input name="search" value="<%= filters.search %>" placeholder="Vehicle / licence / violator / violation ID / challan ID"></div><div><label>Violation Type</label><select name="violation_type"><option value="">All types</option><% types.forEach(t => { %><option value="<%= t %>" <%= filters.violation_type === t ? 'selected' : '' %>><%= t %></option><% }) %></select></div><div><button type="submit">Search</button></div></form></div>
<% if (searched) { %><div class="panel"><h3>Results (<%= results.length %>)</h3><div class="table-scroll"><table><thead><tr><th>Violation</th><th>Vehicle</th><th>Violator</th><th>Licence</th><th>Type</th><th>Challan</th><th>Status</th></tr></thead><tbody><% if (!results.length) { %><tr><td colspan="7">No matching records found.</td></tr><% } %><% results.forEach(r => { %><tr><td><a href="/officer/violations/<%= r.violation_id %>">#<%= r.violation_id %></a></td><td><%= r.registration_no %></td><td><%= r.violator_name %></td><td><%= r.license_no %></td><td><%= r.violation_type %></td><td><%= r.challan_id ? '#' + r.challan_id : '—' %></td><td><%= r.challan_status || 'No challan' %></td></tr><% }) %></tbody></table></div></div><% } %>
<%- include('../partials/footer') %>

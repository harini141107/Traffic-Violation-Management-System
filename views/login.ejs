<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Login - TVMS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="auth-shell">
    <div class="auth-left">
      <span class="brand-mark"><span></span><span></span><span></span></span>
      <h1>Traffic Violation<br>Management System</h1>
      <p>Sign in to record violations, manage challans, and track payments.</p>
    </div>
    <div class="auth-right">
      <div class="auth-card">
        <h2><%= role.charAt(0).toUpperCase() + role.slice(1) %> Login</h2>
        <% if (error) { %>
          <p class="error"><%= error %></p>
        <% } %>
        <form action="/login" method="POST">
          <input type="hidden" name="role" value="<%= role %>">
          <label>Username</label>
          <input type="text" name="username" required>
          <label>Password</label>
          <input type="password" name="password" required>
          <button type="submit">Login</button>
        </form>
        <a class="link" href="/register">Don't have an account? Register</a>
        <a class="link" href="/">&larr; Back to role selection</a>
      </div>
    </div>
  </div>
</body>
</html>
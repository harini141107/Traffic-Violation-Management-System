<%- include('partials/header', { pageTitle: mode === 'add' ? 'Add Violator' : 'Edit Violator', active: 'violators' }) %>
  <div class="page-head">
    <h1><%= mode === 'add' ? 'Add Violator' : 'Edit Violator' %></h1>
  </div>
  <div class="panel" style="max-width:480px;">
    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>
    <form action="<%= mode === 'add' ? '/violators/add' : '/violators/edit/' + violator.violator_id %>" method="POST">
      <label>Name</label>
      <input type="text" name="name" value="<%= violator ? violator.name : '' %>" required>

      <label>License Number</label>
      <input type="text" name="license_no" value="<%= violator ? violator.license_no : '' %>" required>

      <label>Phone</label>
      <input type="text" name="phone" value="<%= violator ? (violator.phone || '') : '' %>">

      <label>Address</label>
      <input type="text" name="address" value="<%= violator ? (violator.address || '') : '' %>">

      <button type="submit"><%= mode === 'add' ? 'Add Violator' : 'Save Changes' %></button>
    </form>
    <a class="link" href="/violators">&larr; Back to Violators</a>
  </div>
<%- include('partials/footer') %>
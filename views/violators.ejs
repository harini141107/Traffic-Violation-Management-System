<%- include('partials/header', { pageTitle: 'Violators', active: 'violators' }) %>
  <div class="page-head">
    <h1>Violators</h1>
    <p class="page-sub">Manage violator records</p>
  </div>
  <div class="panel">
    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>
    <a class="link" style="margin-top:0; margin-bottom:1rem; text-align:left;" href="/violators/add">+ Add Violator</a>

    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>License No</th>
          <th>Phone</th>
          <th>Demerit Points</th>
          <th>License Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (violators.length === 0) { %>
          <tr><td colspan="6">No violators found. Add one to get started.</td></tr>
        <% } %>
        <% violators.forEach(v => { %>
          <tr>
            <td><%= v.name %></td>
            <td><%= v.license_no %></td>
            <td><%= v.phone || '-' %></td>
            <td><%= v.demerit_points %></td>
            <td>
              <span class="badge <%= v.license_status === 'Active' ? 'badge-paid' : 'badge-unpaid' %>">
                <%= v.license_status %>
              </span>
            </td>
            <td>
              <a href="/violators/edit/<%= v.violator_id %>">Edit</a>
              <form action="/violators/delete/<%= v.violator_id %>" method="POST" style="display:inline"
                    onsubmit="return confirm('Delete this violator?');">
                <button type="submit" class="link-btn" style="width:auto; padding:0;">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<%- include('partials/footer') %>
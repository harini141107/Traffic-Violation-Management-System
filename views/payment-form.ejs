<%- include('partials/header', { pageTitle: 'Pay Fine', active: 'challans' }) %>
  <div class="page-head">
    <h1>Pay Fine</h1>
  </div>
  <div class="panel" style="max-width:480px;">
    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>
    <p><strong>Vehicle:</strong> <%= challan.registration_no %></p>
    <p><strong>Violator:</strong> <%= challan.violator_name %></p>
    <p><strong>Violation:</strong> <%= challan.violation_type %></p>
    <p><strong>Amount Due:</strong> ₹<%= challan.fine_amount %></p>

    <form action="/payments/pay/<%= challan.challan_id %>" method="POST">
      <label>Amount</label>
      <input type="number" step="0.01" name="amount_paid" value="<%= challan.fine_amount %>" required>

      <label>Payment Mode</label>
      <select name="payment_mode" required>
        <option value="Cash">Cash</option>
        <option value="UPI">UPI</option>
        <option value="Card">Card</option>
        <option value="Net Banking">Net Banking</option>
      </select>

      <button type="submit">Confirm Payment</button>
    </form>
    <a class="link" href="/challans">&larr; Back to Challans</a>
  </div>
<%- include('partials/footer') %>